---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { empresa } from '../data/sitio';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const {
  titulo,
  descripcion = `${empresa.nombre}, ${empresa.lema.toLowerCase()} con más de ${empresa.anios} años de experiencia en ${empresa.sedes.join(' y ')}. Operaciones portuarias, logística extraportuaria, almacenamiento y alquiler de equipos.`,
} = Astro.props;

const tituloCompleto = titulo
  ? `${titulo} · ${empresa.nombre}`
  : `${empresa.nombre} · ${empresa.lema}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={Astro.site?.href} />
    <link rel="icon" type="image/svg+xml" href="/marca/isotipo.svg" />
    <meta name="theme-color" content="#070b26" />

    <meta property="og:site_name" content={empresa.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${empresa.nombre}, ${empresa.lema}`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body class="min-h-dvh">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-green focus:px-5 focus:py-3 focus:font-display focus:font-semibold focus:text-navy-950"
    >
      Saltar al contenido
    </a>

    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
