---
import Titular from './Titular.astro';
import { empresa, tiposDeCarga } from '../data/sitio';

/**
 * Fondo del hero: fotos propias de Cargoban en Santa Marta que se funden una en otra
 * con un acercamiento lento. Sin JavaScript y sin animación se ve la primera, quieta.
 * Nada de material de terceros aquí: ni videos ni fotos de Puerto Antioquia (AGENTS.md).
 * Con una lista vacía queda el fondo de marca.
 */
// `foco`: qué parte de la foto se conserva cuando la pantalla la recorta (en móvil, los costados).
const fotos: { src: string; foco: string }[] = [
  { src: '/fotos/portada-izaje.webp', foco: '50% 50%' },
  { src: '/fotos/portada-equipo.webp', foco: '55% 50%' },
  { src: '/fotos/portada-operario.webp', foco: '30% 50%' },
];
---

<section id="inicio" class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden">
  <!-- Capa de fondo: fotos propias o, sin fotos, la textura derivada del símbolo (permitida por el manual de marca) -->
  <div class="absolute inset-0 -z-10 fondo-marca">
    {fotos.length > 0 ? (
      <>
        {fotos.map(({ src, foco }, i) => (
          <img
            src={src}
            alt=""
            class="portada-foto absolute inset-0 size-full object-cover"
            style={`--n:${fotos.length}; --i:${i}; object-position:${foco}`}
            fetchpriority={i === 0 ? 'high' : 'low'}
            decoding="async"
          />
        ))}
        {/* Velo azul de marca sobre las fotos: el titular se lee siempre. */}
        <div class="absolute inset-0 bg-navy-950/65" aria-hidden="true"></div>
      </>
    ) : (
      <div
        class="absolute inset-0 opacity-[0.07] mix-blend-overlay"
        style="background-image:url('/marca/isotipo-blanco.svg');background-size:clamp(90px,11vw,180px);background-repeat:repeat"
        aria-hidden="true"
      >
      </div>
    )}
    <div
      class="absolute inset-0"
      style="background:linear-gradient(to top,var(--color-navy-950) 8%,transparent 60%)"
      aria-hidden="true"
    >
    </div>
  </div>

  <div class="contenedor pb-16 pt-32 lg:pb-24">
    <Titular
      as="h1"
      texto="Operamos la *carga* que mueve al Caribe"
      class="max-w-[16ch] font-display font-semibold text-white"
      style="font-size:var(--text-hero)"
    />

    <div class="mt-10 flex flex-col gap-10 border-t border-white/15 pt-8 lg:flex-row lg:items-end lg:justify-between">
      <p class="max-w-xl text-white/75" style="font-size:var(--text-cuerpo-lg)">
        Somos una empresa colombiana que lleva más de {empresa.anios} años trabajando en los
        puertos de {empresa.sedes.join(' y ')}. Cargamos y descargamos buques, llevamos la
        carga fuera del puerto y la guardamos hasta su destino, con gente propia que conoce
        el oficio.
      </p>

      <div class="flex flex-wrap items-center gap-4">
        <a
          href="#servicios"
          class="group inline-flex items-center gap-3 rounded-full bg-white px-7 py-4 font-display font-semibold text-navy-950 transition-colors hover:bg-green"
        >
          Ver servicios
          <svg class="size-4 transition-transform duration-300 ease-suave group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path d="M2 8h12M9 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a
          href="#contacto"
          class="inline-flex items-center rounded-full border border-white/30 px-7 py-4 font-display font-semibold text-white transition-colors hover:bg-white/10"
        >
          Hablar con nosotros
        </a>
      </div>
    </div>

    <!-- Datos de la operación. Solo hechos verificables, sin cifras inventadas. -->
    <dl class="mt-14 grid gap-px overflow-hidden rounded-xl bg-white/10 sm:grid-cols-3">
      {[
        { cifra: `+${empresa.anios}`, texto: 'años de experiencia' },
        { cifra: String(empresa.sedes.length), texto: `sedes: ${empresa.sedes.join(' y ')}` },
        { cifra: String(tiposDeCarga.length), texto: 'tipos de carga que manejamos' },
      ].map((dato) => (
        <div class="bg-navy-950/60 px-6 py-5 backdrop-blur-sm">
          <dt class="text-sm text-white/65">{dato.texto}</dt>
          <dd class="cifra mt-1 font-display text-4xl font-bold leading-none text-white lg:text-5xl">
            {dato.cifra}
          </dd>
        </div>
      ))}
    </dl>
  </div>

  <!--
    Centinela de la cabecera: ocupa la franja que la cabecera cubre al inicio.
    Mientras parte de esa franja se vea, la cabecera queda transparente.
  -->
  <div id="centinela-cabecera" class="absolute inset-x-0 top-0 h-20 lg:h-24" aria-hidden="true"></div>
</section>

