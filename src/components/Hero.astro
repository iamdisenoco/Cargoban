---
import Titular from './Titular.astro';
import { empresa, clientes } from '../data/sitio';

/**
 * Fondo del hero: fotos propias de Cargoban en Santa Marta que se funden una en otra
 * con un acercamiento lento. Sin JavaScript y sin animación se ve la primera, quieta.
 * Nada de material de terceros aquí: ni videos ni fotos de Puerto Antioquia (AGENTS.md).
 * Con una lista vacía queda el fondo de marca.
 */
// `foco`: qué parte de la foto se conserva cuando la pantalla la recorta.
// `focoMovil`: lo mismo en la franja de foto del móvil, que es casi cuadrada y recorta
// los costados. Se eligió mirando cada foto: la llanta, el grupo con su jefe, el operario.
const fotos: { src: string; foco: string; focoMovil: string }[] = [
  { src: '/fotos/portada-izaje.webp', foco: '50% 50%', focoMovil: '72% 50%' },
  { src: '/fotos/portada-equipo.webp', foco: '55% 50%', focoMovil: '33% 50%' },
  { src: '/fotos/portada-operario.webp', foco: '30% 50%', focoMovil: '27% 50%' },
];

// Logos en blanco para la franja «Confían en nosotros» (siluetas con fondo transparente
// en public/clientes/silueta/). Solo los que se leen bien en una sola tinta.
const destacados = ['puerto-santa-marta', 'smitco', 'uniban', 'greenland', 'transmares'].map((id) => ({
  id,
  nombre: clientes.find((c) => c.logo?.includes(id))?.nombre ?? id,
}));
---

<!--
  En móvil la foto va arriba, limpia, y el texto debajo sobre el azul: con el texto
  encima de la foto a pantalla completa, el titular tapaba las caras (Jon, 25/09).
  Desde md vuelve a ser foto de fondo a pantalla completa con el texto encima.
-->
<section id="inicio" class="portada-fija relative isolate flex flex-col overflow-hidden bg-navy-950 md:min-h-[100svh] md:justify-end">
  <!-- Capa de fondo: fotos propias o, sin fotos, la textura derivada del símbolo (permitida por el manual de marca) -->
  <div class="portada-fondo relative -z-10 h-[62svh] min-h-80 overflow-hidden fondo-marca md:absolute md:inset-0 md:h-auto">
    {fotos.length > 0 ? (
      <>
        {fotos.map(({ src, foco, focoMovil }, i) => (
          <img
            src={src}
            alt=""
            class="portada-foto absolute inset-0 size-full object-cover"
            style={`--n:${fotos.length}; --i:${i}; --foco:${foco}; --foco-movil:${focoMovil}`}
            fetchpriority={i === 0 ? 'high' : 'low'}
            decoding="async"
          />
        ))}
        {/* Velo azul de marca sobre las fotos: el titular se lee siempre. */}
        <div class="absolute inset-0 bg-navy-950/20 md:bg-transparent" aria-hidden="true" style="background-image:var(--velo-portada,none)"></div>
      </>
    ) : (
      <div
        class="absolute inset-0 opacity-[0.07] mix-blend-overlay"
        style="background-image:url('/marca/isotipo-blanco.svg');background-size:clamp(90px,11vw,180px);background-repeat:repeat"
        aria-hidden="true"
      >
      </div>
    )}
    <div
      class="absolute inset-0"
      style="background:linear-gradient(to top,var(--color-navy-950) 8%,transparent 60%)"
      aria-hidden="true"
    >
    </div>
  </div>

  <!--
    Composición tomada de cargokite.com (Jon, 02/10: «más impactante y limpio»): titular
    grande en peso medio a media altura, sin botones ni línea; abajo a la izquierda los
    clientes en blanco y abajo a la derecha un texto corto con una frase en verde.
  -->
  <div class="portada-texto contenedor relative -mt-10 flex flex-1 flex-col pb-12 md:mt-0 md:pt-40 md:pb-14 lg:pb-16">
    <div class="md:flex md:flex-1 md:items-center">
      <Titular
        as="h1"
        texto="Operamos la *carga* que mueve al Caribe"
        class="portada-titular max-w-[9.8em] font-display text-white"
        style="font-size:clamp(2.6rem, 1rem + 5.4vw, 6.25rem)"
      />
    </div>

    <div class="mt-10 flex flex-col gap-10 md:mt-16 md:flex-row-reverse md:items-end md:justify-between">
      <p class="max-w-md text-white md:max-w-[26rem]" style="font-size:var(--text-cuerpo-lg);line-height:1.45">
        Más de {empresa.anios} años moviendo carga en {empresa.sedes.join(' y ')},
        con <span class="text-green">equipos y personal especializado</span> en cada operación.
      </p>

      <div>
        <p class="text-sm text-white/70">Confían en nosotros:</p>
        <ul class="mt-4 flex flex-wrap items-center gap-x-7 gap-y-4 lg:gap-x-9">
          {destacados.map((c) => (
            <li>
              <img src={`/clientes/silueta/${c.id}.webp`} alt={c.nombre} class="h-8 w-auto opacity-90 lg:h-10" loading="lazy" decoding="async" />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

</section>

