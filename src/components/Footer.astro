---
import { empresa, navegacion, sedes, enlaceWhatsapp, numeroMarcable } from '../data/sitio';
import Instagram from './iconos/Instagram.astro';
import WhatsApp from './iconos/WhatsApp.astro';
const anio = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-navy-950">
  <div class="contenedor py-16 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <img
          src="/marca/logo-vertical-blanco.svg"
          alt={`${empresa.nombre}, ${empresa.lema}`}
          width="200"
          height="123"
          class="h-24 w-auto"
        />
        <p class="mt-7 max-w-sm text-white/60">
          Operador logístico y portuario con más de {empresa.anios} años de experiencia
          en {empresa.sedes.join(' y ')}.
        </p>
        <ul class="mt-6 flex gap-3" aria-label="Redes sociales">
          <li>
            <a
              href={empresa.instagram}
              target="_blank"
              rel="noopener"
              class="inline-flex size-11 items-center justify-center rounded-full border border-white/20 text-white/80 transition-colors hover:border-green hover:text-green"
            >
              <Instagram class="size-5" />
              <span class="sr-only">Instagram de {empresa.nombre} (se abre en una pestaña nueva)</span>
            </a>
          </li>
          <li>
            <a
              href={enlaceWhatsapp}
              target="_blank"
              rel="noopener"
              class="inline-flex size-11 items-center justify-center rounded-full border border-white/20 text-white/80 transition-colors hover:border-green hover:text-green"
            >
              <WhatsApp class="size-5" />
              <span class="sr-only">WhatsApp de {empresa.nombre} (se abre en una pestaña nueva)</span>
            </a>
          </li>
        </ul>
      </div>

      <nav class="lg:col-span-3 lg:col-start-10" aria-label="Pie de página">
        <p class="etiqueta text-white/60">Navegación</p>
        <ul class="mt-4">
          {navegacion.map((item) => (
            <li>
              <a href={item.href} class="inline-flex min-h-11 items-center text-white/80 transition-colors hover:text-green">
                {item.etiqueta}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <!-- Sedes con sus datos de contacto, en letra pequeña (Jon, 25/09). -->
    <ul class="mt-14 grid gap-10 border-t border-white/10 pt-10 text-sm sm:grid-cols-2 lg:grid-cols-3">
      {sedes.map((sede) => (
        <li>
          <p class="font-display font-semibold text-white">{sede.ciudad}</p>
          <address class="mt-2 not-italic leading-relaxed text-white/60">
            {sede.direccion.map((linea) => <span class="block">{linea}</span>)}
            <span class="block">{sede.ciudad}, {sede.region}</span>
          </address>
          <p class="mt-2 leading-relaxed text-white/60">
            Tel. <a href={`tel:${numeroMarcable(sede.telefono)}`} class="text-white/80 underline-offset-4 hover:text-green hover:underline">{sede.telefono}</a>
            <span class="block">
              Cel. <a href={`tel:${numeroMarcable(sede.celular)}`} class="text-white/80 underline-offset-4 hover:text-green hover:underline">{sede.celular}</a>
            </span>
          </p>
        </li>
      ))}
    </ul>
  </div>

  <div class="border-t border-white/10">
    <div class="contenedor flex flex-col gap-3 py-6 text-xs text-white/60 sm:flex-row sm:items-center sm:justify-between">
      <p>© {anio} {empresa.nombre}. Todos los derechos reservados.</p>
      <p>{empresa.lema}</p>
    </div>
  </div>
</footer>
