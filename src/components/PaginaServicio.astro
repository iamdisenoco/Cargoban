---
/**
 * Página de un servicio (Jon, 23/10). Arriba el servicio con su foto, después lo que
 * incluye, los tipos de carga, el formulario con el servicio ya elegido y los demás
 * servicios. Los textos salen de `sitio.ts` / `sitio.en.ts`; Cargoban va a ampliarlos.
 */
import Base from '../layouts/Base.astro';
import Titular from './Titular.astro';
import FormularioContacto from './FormularioContacto.astro';
import WhatsApp from './iconos/WhatsApp.astro';
import { contenido } from '../data/contenido';
import { paginasServicios, rutaServicio } from '../data/paginasServicios';
import { traductor, rutaInicio, type Idioma } from '../i18n/idioma';

interface Props {
  idioma: Idioma;
  numero: string;
}
const { idioma, numero } = Astro.props;
const t = traductor(idioma);
const { empresa, servicios, tiposDeCarga } = contenido(idioma);
const servicio = servicios.find((s) => s.numero === numero)!;
const pagina = paginasServicios.find((p) => p.numero === numero)!;
const otros = servicios.filter((s) => s.numero !== numero);
const rutas = { es: rutaServicio('es', numero), en: rutaServicio('en', numero) };

// La última palabra del título va en verde, como en los titulares de la portada.
const palabras = servicio.titulo.split(' ');
const tituloMarcado = [...palabras.slice(0, -1), `*${palabras.at(-1)}*`].join(' ');

const mensaje = t(
  `Hola, quiero información sobre el servicio de ${servicio.titulo.toLowerCase()} de Cargoban.`,
  `Hello, I would like information about Cargoban’s ${servicio.titulo.toLowerCase()} service.`,
);
const enlaceWhatsapp = `https://wa.me/${empresa.whatsapp.numero}?text=${encodeURIComponent(mensaje)}`;
const nuevaPestana = t('(se abre en una pestaña nueva)', '(opens in a new tab)');
---

<Base idioma={idioma} rutas={rutas} titulo={servicio.titulo} descripcion={`${servicio.resumen} ${servicio.detalle}`}>
  <section class="relative overflow-hidden bg-navy-950 pt-32 pb-20 text-white lg:pt-44 lg:pb-28">
    <div id="centinela-cabecera" class="pointer-events-none absolute inset-x-0 top-0 h-20 lg:h-24" aria-hidden="true"></div>
    <div class="contenedor grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-x-20">
      <div class="lg:col-span-7">
        <nav aria-label={t('Ruta de navegación', 'Breadcrumb')}>
          <ol class="flex flex-wrap items-center gap-2 text-sm text-white/60">
            <li><a href={rutaInicio[idioma]} class="hover:text-white">{t('Inicio', 'Home')}</a></li>
            <li aria-hidden="true">/</li>
            <li><a href={`${rutaInicio[idioma]}#servicios`} class="hover:text-white">{t('Servicios', 'Services')}</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-white">{servicio.titulo}</li>
          </ol>
        </nav>
        <p class="cifra mt-12 font-display text-sm font-semibold text-teal-400">{servicio.numero}</p>
        <Titular as="h1" texto={tituloMarcado} class="mt-4 text-white" style="font-size:var(--text-titulo)" />
        <p class="revelar mt-8 max-w-xl text-white/75" style="font-size:var(--text-cuerpo-lg)">{servicio.resumen}</p>
        <div class="revelar mt-10 flex flex-wrap gap-4">
          <a
            href="#contacto"
            class="inline-flex items-center gap-3 rounded-full bg-green px-7 py-4 font-display font-semibold text-navy-950 transition-colors hover:bg-green-300"
          >
            {t('Solicitar este servicio', 'Request this service')}
            <span aria-hidden="true">→</span>
          </a>
          <a
            href={enlaceWhatsapp}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-3 rounded-full border border-white/25 px-7 py-4 font-display font-semibold text-white transition-colors hover:border-white hover:bg-white hover:text-navy-950"
          >
            <WhatsApp class="size-5" />
            WhatsApp
            <span class="sr-only">{nuevaPestana}</span>
          </a>
        </div>
      </div>
      <figure class="foto-abre aspect-[4/5] max-h-[70svh] overflow-hidden rounded-2xl lg:col-span-5">
        <img src={pagina.foto} alt={pagina.alt[idioma]} class="size-full object-cover" decoding="async" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="bg-white py-24 text-ink lg:py-32">
    <div class="contenedor grid gap-14 lg:grid-cols-12 lg:gap-x-20">
      <div class="lg:col-span-5">
        <Titular texto={t('Qué *incluye*', 'What it *includes*')} class="text-navy" style="font-size:var(--text-seccion)" />
        <p class="revelar mt-8 max-w-md font-display font-semibold text-navy" style="font-size:var(--text-subtitulo);line-height:1.25;letter-spacing:-0.02em">
          {servicio.detalle}
        </p>
      </div>
      <ol class="grid content-start gap-x-10 sm:grid-cols-2 lg:col-span-7">
        {servicio.items.map((item, i) => (
          <li class="revelar flex items-baseline gap-4 border-t border-ink/15 py-6">
            <span class="cifra w-6 shrink-0 font-display text-sm font-semibold text-teal">{String(i + 1).padStart(2, '0')}</span>
            <span class="font-display text-xl font-semibold text-navy">{item}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="border-t border-ink/10 bg-white pb-24 text-ink lg:pb-32">
    <div class="contenedor pt-20 lg:pt-24">
      <h2 class="revelar font-display font-semibold text-navy" style="font-size:var(--text-subtitulo);letter-spacing:-0.02em">
        {t('Experiencia en todo tipo de carga', 'Experience with every type of cargo')}
      </h2>
      <ul class="revelar mt-8 flex flex-wrap gap-3">
        {tiposDeCarga.map((tipo) => (
          <li class="rounded-full border border-ink/15 px-5 py-2.5 text-ink-soft">{tipo}</li>
        ))}
      </ul>
    </div>
  </section>

  <section id="contacto" class="scroll-mt-24 border-t border-ink/10 bg-white py-24 text-ink lg:py-32">
    <div class="contenedor grid gap-14 lg:grid-cols-12 lg:gap-x-20">
      <div class="lg:col-span-5">
        <Titular texto={t('Cotice este *servicio*', 'Request this *service*')} class="text-navy" style="font-size:var(--text-seccion)" />
        <p class="revelar mt-8 max-w-md text-ink-soft" style="font-size:var(--text-cuerpo-lg)">
          {t(
            'Cuéntenos qué necesita y una persona de nuestro equipo le responde.',
            'Tell us what you need and a person on our team will get back to you.',
          )}
        </p>
      </div>
      <div class="revelar lg:col-span-7">
        <FormularioContacto idioma={idioma} servicio={servicio.titulo} />
      </div>
    </div>
  </section>

  <section class="bg-navy-950 py-24 text-white lg:py-32">
    <div class="contenedor">
      <Titular texto={t('Otros *servicios*', 'Other *services*')} class="text-white" style="font-size:var(--text-seccion)" />
      <ul class="mt-12 border-b border-white/12">
        {otros.map((otro) => (
          <li class="revelar border-t border-white/12">
            <a href={rutaServicio(idioma, otro.numero)} class="group grid gap-2 py-7 sm:grid-cols-12 sm:items-baseline sm:gap-8">
              <span class="cifra font-display text-sm font-semibold text-teal-400 sm:col-span-1">{otro.numero}</span>
              <span class="font-display text-2xl font-semibold transition-colors group-hover:text-green sm:col-span-5">{otro.titulo}</span>
              <span class="text-white/60 sm:col-span-5">{otro.resumen}</span>
              <span class="hidden text-right text-xl text-white/40 transition-[color,translate] group-hover:translate-x-1 group-hover:text-green sm:col-span-1 sm:block" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
