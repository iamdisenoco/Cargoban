---
/**
 * Íconos de «¿Por qué elegirnos?», redibujados en trazo a partir de los del brochure
 * de Cargoban (lámina «¿Por qué elegirnos?», Jon, 23/10). Mismo motivo por razón:
 * sello, bombillo, barras que suben, documento con chequeos, escudo con cruz, signo
 * de pesos, grupo de personas y persona dentro de un escudo.
 */
import type { IconoRazon } from '../../data/sitio';

interface Props {
  icono: IconoRazon;
  class?: string;
}
const { icono, class: clase } = Astro.props;
---

<svg
  class={clase}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {icono === 'experiencia' && (
    <>
      <circle cx="12" cy="9" r="6" />
      <path d="m12 6.2.9 1.8 2 .3-1.45 1.4.35 2-1.8-.95-1.8.95.35-2L9.1 8.3l2-.3.9-1.8Z" />
      <path d="M8.6 13.9 7.5 21l4.5-2.2 4.5 2.2-1.1-7.1" />
    </>
  )}
  {icono === 'innovacion' && (
    <>
      <path d="M12 6a5 5 0 0 0-3 9c.6.5 1 1.1 1 1.9v.6h4v-.6c0-.8.4-1.4 1-1.9a5 5 0 0 0-3-9Z" />
      <path d="M10.2 20.5h3.6M12 2v1.5M4.6 4.6l1 1M19.4 4.6l-1 1M2.5 11H4M20 11h1.5" />
    </>
  )}
  {icono === 'rendimiento' && (
    <>
      <path d="M5 21v-3.5M10 21v-6M15 21v-4.5M20 21v-9" stroke-width="2.4" />
      <path d="m4 12.5 5-5 4 3 6.5-6.5M15.5 4h4v4" />
    </>
  )}
  {icono === 'legal' && (
    <>
      <rect x="5" y="2.5" width="14" height="19" rx="2" />
      <path d="m8.3 7.8 1.1 1.1 2-2.1M13.5 8h2.6M8.3 12.8l1.1 1.1 2-2.1M13.5 13h2.6M8.5 17.5h7" />
    </>
  )}
  {icono === 'sst' && (
    <>
      <path d="M12 2.5 19 5.5V11c0 4.6-3 8.4-7 10-4-1.6-7-5.4-7-10V5.5l7-3Z" />
      <path d="M12 8.5v6M9 11.5h6" />
    </>
  )}
  {icono === 'costos' && (
    <>
      <path d="M12 2.5v19" />
      <path d="M16.3 7.3C15.7 5.9 14.1 5 12.2 5 9.8 5 8 6.3 8 8.2c0 4.4 8.5 2.4 8.5 6.9 0 1.9-1.9 3.3-4.3 3.3-2 0-3.7-1-4.3-2.6" />
    </>
  )}
  {icono === 'adaptacion' && (
    <>
      <circle cx="12" cy="7.5" r="2.6" />
      <circle cx="5.3" cy="9.5" r="2" />
      <circle cx="18.7" cy="9.5" r="2" />
      <path d="M7.4 20v-1.5a4.6 4.6 0 0 1 9.2 0V20M2 19v-1a3.4 3.4 0 0 1 4.6-3.2M22 19v-1a3.4 3.4 0 0 0-4.6-3.2" />
    </>
  )}
  {icono === 'personal' && (
    <>
      <path d="M12 2.5 19 5.5V11c0 4.6-3 8.4-7 10-4-1.6-7-5.4-7-10V5.5l7-3Z" />
      <circle cx="12" cy="9.6" r="2.3" />
      <path d="M8.4 16.4a3.8 3.8 0 0 1 7.2 0" />
    </>
  )}
</svg>
