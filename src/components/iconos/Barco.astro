---
/** Buque portacontenedores visto de lado, con la proa a la derecha. Colores de marca. */
interface Props { class?: string }
const { class: clase } = Astro.props;
---

<svg class={clase} viewBox="0 0 64 30" fill="none" aria-hidden="true">
  <!-- contenedores -->
  <rect x="14" y="10" width="8" height="6" rx="0.6" fill="var(--color-teal)" />
  <rect x="23" y="10" width="8" height="6" rx="0.6" fill="var(--color-green)" />
  <rect x="32" y="10" width="8" height="6" rx="0.6" fill="var(--color-navy)" />
  <rect x="41" y="10" width="8" height="6" rx="0.6" fill="var(--color-teal)" />
  <rect x="23" y="4" width="8" height="6" rx="0.6" fill="var(--color-navy)" />
  <rect x="32" y="4" width="8" height="6" rx="0.6" fill="var(--color-teal)" />
  <!-- puente de mando, a popa -->
  <rect x="5" y="3" width="7" height="13" rx="0.8" fill="var(--color-navy)" />
  <rect x="6.5" y="5" width="4" height="2" rx="0.4" fill="#fff" opacity="0.85" />
  <rect x="7.5" y="0" width="2" height="3" fill="var(--color-navy)" />
  <!-- casco -->
  <path d="M1 16h62l-6.5 11.5a2 2 0 0 1-1.7 1H7.5a2 2 0 0 1-1.7-.9L1 16Z" fill="var(--color-navy)" />
  <path d="M3 19.5h58" stroke="var(--color-green)" stroke-width="1.4" />
</svg>
