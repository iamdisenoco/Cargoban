---
import { tiposDeCarga } from '../data/sitio';

// Se duplica la lista para que el desplazamiento sea continuo sin cortes.
const secuencia = [...tiposDeCarga, ...tiposDeCarga];
---

<div class="border-y border-white/10 bg-navy-900 py-2.5 lg:py-3">
  <div class="flex overflow-hidden" aria-hidden="true">
    <ul class="cinta flex shrink-0 items-center gap-6 pr-6 lg:gap-10 lg:pr-10">
      {secuencia.map((tipo) => (
        <li class="flex shrink-0 items-center gap-6 font-display text-sm font-medium text-white/70 lg:gap-10 lg:text-base">
          {tipo}
          <span class="size-1 shrink-0 rotate-45 bg-white/30"></span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Versión accesible y legible por buscadores, sin movimiento -->
  <p class="sr-only">
    Tipos de carga que manejamos: {tiposDeCarga.join(', ')}.
  </p>
</div>
