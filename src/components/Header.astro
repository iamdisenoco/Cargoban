---
import { contenido } from '../data/contenido';
import { traductor, rutaInicio, type Idioma } from '../i18n/idioma';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const t = traductor(idioma);
const { navegacion, empresa } = contenido(idioma);
const otro: Idioma = idioma === 'es' ? 'en' : 'es';
---

<header
  id="cabecera"
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,backdrop-filter,border-color] duration-500"
>
  <div id="cabecera-barra" class="contenedor flex h-20 items-center justify-between gap-6 transition-[height] duration-500 ease-suave lg:h-24">
    <a href="#inicio" class="inline-flex min-h-11 shrink-0 items-center" aria-label={t(`${empresa.nombre}, ir al inicio`, `${empresa.nombre}, go to top`)}>
      <img
        src="/marca/logo-horizontal-blanco.svg"
        alt=""
        width="220"
        height="60"
        id="cabecera-logo"
        class="h-9 w-auto transition-[height] duration-500 ease-suave lg:h-11"
      />
    </a>

    <nav class="hidden items-center gap-10 lg:flex" aria-label={t('Principal', 'Main')}>
      {navegacion.map((item) => (
        <a
          href={item.href}
          class="group relative font-display text-sm font-medium text-white/85 transition-colors hover:text-white"
        >
          {item.etiqueta}
          <span class="absolute -bottom-1.5 left-0 h-px w-0 bg-green transition-all duration-300 ease-suave group-hover:w-full"></span>
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <!--
        Selector de idioma (Jon, 02/10): el español va primero y la persona elige; el
        idioma nunca cambia solo. Lleva a la misma sección en el otro idioma.
      -->
      <a
        href={rutaInicio[otro]}
        hreflang={otro}
        data-cambiar-idioma
        class="inline-flex min-h-11 items-center gap-1.5 rounded-full px-2 font-display text-sm font-medium"
        aria-label={t('Ver el sitio en inglés', 'View the site in Spanish')}
      >
        <span class:list={[idioma === 'es' ? 'text-white' : 'text-white/50 hover:text-white']}>ES</span>
        <span class="text-white/30" aria-hidden="true">|</span>
        <span class:list={[idioma === 'en' ? 'text-white' : 'text-white/50 hover:text-white']}>EN</span>
      </a>

      <a
        href="#contacto"
        class="hidden rounded-full bg-green px-6 py-2.5 font-display text-sm font-semibold text-navy-950 transition-colors hover:bg-green-300 lg:inline-flex"
      >
        {t('Cotizar operación', 'Request a quote')}
      </a>

      <button
        id="menu-boton"
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-full border border-white/25 text-white transition-colors hover:bg-white/10 lg:hidden"
        aria-controls="menu-movil"
        aria-expanded="false"
        data-abrir={t('Abrir menú', 'Open menu')}
        data-cerrar={t('Cerrar menú', 'Close menu')}
      >
        <span class="sr-only" id="menu-boton-texto">{t('Abrir menú', 'Open menu')}</span>
        <svg
          id="menu-icono-abrir"
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          aria-hidden="true"
        >
          <path stroke-linecap="round" d="M3 7h18M3 12h18M3 17h18" />
        </svg>
        <svg
          id="menu-icono-cerrar"
          class="hidden size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          aria-hidden="true"
        >
          <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Menú móvil a pantalla completa -->
<div
  id="menu-movil"
  class="fixed inset-0 z-40 hidden bg-navy-950/98 backdrop-blur-xl lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label={t('Menú de navegación', 'Navigation menu')}
>
  <nav class="contenedor mt-20 flex h-[calc(100%-5rem)] flex-col justify-center gap-2 overflow-y-auto pt-4 pb-10 [@media(max-height:560px)]:justify-start" aria-label={t('Principal móvil', 'Main mobile')}>
    {navegacion.map((item, i) => (
      <a
        href={item.href}
        class="flex items-baseline gap-5 border-b border-white/10 py-5 font-display text-4xl font-semibold text-white transition-colors hover:text-green sm:text-5xl [@media(max-height:560px)]:py-3 [@media(max-height:560px)]:text-2xl"
      >
        <span class="w-5 shrink-0 font-sans text-xs text-green tabular-nums">{String(i + 1).padStart(2, '0')}</span>
        {item.etiqueta}
      </a>
    ))}
    <a
      href="#contacto"
      class="mt-8 inline-flex shrink-0 justify-center rounded-full bg-green px-8 py-4 font-display text-base font-semibold text-navy-950"
    >
      {t('Cotizar operación', 'Request a quote')}
    </a>
  </nav>
</div>

{/*
  Aviso discreto cuando el navegador está en el otro idioma: en la página española,
  «View in English»; en la inglesa, «Ver en español». No cambia nada solo, solo ofrece
  la otra versión. Nace oculto; si se cierra, no vuelve a salir.
  El de español se agregó el 08/10: alguien abrió la versión en inglés con el traductor
  automático del navegador y vio frases como «Chaquetón» (por «Reefer»).
*/}
<div id="aviso-idioma" data-idioma-navegador={otro} class="fixed top-[4.5rem] left-4 z-30 sm:top-auto sm:bottom-6 flex items-center gap-1 rounded-full border border-white/15 bg-navy-950/90 py-1 pl-4 pr-1 text-sm text-white shadow-lg shadow-black/20 backdrop-blur-md sm:left-6" lang={otro} hidden>
    <a href={rutaInicio[otro]} hreflang={otro} data-cambiar-idioma class="inline-flex min-h-10 items-center gap-2 font-display font-medium hover:text-green">
      {otro === 'en' ? 'View in English' : 'Ver en español'}
      <svg class="size-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </a>
    <button id="aviso-idioma-cerrar" type="button" class="inline-flex size-10 items-center justify-center rounded-full text-white/60 hover:text-white" aria-label={otro === 'en' ? 'Dismiss' : 'Cerrar'}>
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
</div>

<script>
  // Al cambiar de idioma se conserva la sección en la que estaba la persona.
  document.querySelectorAll<HTMLAnchorElement>('[data-cambiar-idioma]').forEach((enlace) => {
    enlace.addEventListener('click', () => {
      if (location.hash) enlace.href = enlace.pathname + location.hash;
    });
  });

  // Aviso de idioma: solo si el navegador está en el otro idioma y no lo cerró antes.
  const aviso = document.getElementById('aviso-idioma');
  if (aviso) {
    const destino = aviso.dataset.idiomaNavegador ?? 'en';
    const clave = `cargoban:aviso-idioma-${destino}`;
    let cerrado = false;
    try {
      cerrado = localStorage.getItem(clave) === 'cerrado';
    } catch {
      /* almacenamiento bloqueado: el aviso puede volver a salir, no pasa nada */
    }
    const delNavegador = (navigator.languages?.[0] ?? navigator.language ?? '').toLowerCase();
    if (delNavegador.startsWith(destino) && !cerrado) aviso.hidden = false;
    document.getElementById('aviso-idioma-cerrar')?.addEventListener('click', () => {
      aviso.hidden = true;
      try {
        localStorage.setItem(clave, 'cerrado');
      } catch {
        /* sin almacenamiento: se cierra solo por esta visita */
      }
    });
  }

  const cabecera = document.getElementById('cabecera');
  const boton = document.getElementById('menu-boton');
  const botonTexto = document.getElementById('menu-boton-texto');
  const iconoAbrir = document.getElementById('menu-icono-abrir');
  const iconoCerrar = document.getElementById('menu-icono-cerrar');
  const menu = document.getElementById('menu-movil');

  /*
    Al bajar, la cabecera se encoge y queda translúcida para que ocupe menos y deje ver
    el contenido por detrás (Jon, 02/10: «opacidad para que no quite tanto espacio»).
    La cabecera se vuelve visible en cuanto el contenido empieza a pasar por detrás.
    El centinela ocupa exactamente la franja que cubre la cabecera al inicio de la
    página: mientras una parte de esa franja siga a la vista, no hemos bajado lo
    suficiente. No depende de la altura del hero, que cambia con el contenido.
  */
  const centinela = document.getElementById('centinela-cabecera');
  if (centinela && cabecera) {
    new IntersectionObserver(([entrada]) => {
      const solido = !entrada.isIntersecting;
      cabecera.classList.toggle('bg-navy-950/55', solido);
      cabecera.classList.toggle('backdrop-blur-md', solido);
      cabecera.classList.toggle('border-b', solido);
      cabecera.classList.toggle('border-white/10', solido);
      const barra = document.getElementById('cabecera-barra');
      barra?.classList.toggle('h-20', !solido);
      barra?.classList.toggle('lg:h-24', !solido);
      barra?.classList.toggle('h-14', solido);
      barra?.classList.toggle('lg:h-16', solido);
      const logo = document.getElementById('cabecera-logo');
      logo?.classList.toggle('h-9', !solido);
      logo?.classList.toggle('lg:h-11', !solido);
      logo?.classList.toggle('h-7', solido);
      logo?.classList.toggle('lg:h-8', solido);
    }).observe(centinela);
  }

  // Elementos que pueden recibir foco dentro del menú abierto.
  function enfocables(): HTMLElement[] {
    return Array.from(menu?.querySelectorAll<HTMLElement>('a[href], button') ?? []);
  }

  function alternarMenu(abrir: boolean) {
    menu?.classList.toggle('hidden', !abrir);
    boton?.setAttribute('aria-expanded', String(abrir));
    iconoAbrir?.classList.toggle('hidden', abrir);
    iconoCerrar?.classList.toggle('hidden', !abrir);
    if (botonTexto) botonTexto.textContent = (abrir ? boton?.dataset.cerrar : boton?.dataset.abrir) ?? '';
    document.body.style.overflow = abrir ? 'hidden' : '';
    if (abrir) enfocables()[0]?.focus();
    else boton?.focus();
  }

  boton?.addEventListener('click', () => alternarMenu(menu?.classList.contains('hidden') ?? true));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => alternarMenu(false)));

  // Tocar el fondo cierra el menú: en un teléfono no hay tecla de escape.
  menu?.addEventListener('click', (e) => {
    if (e.target === menu) alternarMenu(false);
  });

  document.addEventListener('keydown', (e) => {
    if (!menu || menu.classList.contains('hidden')) return;

    if (e.key === 'Escape') {
      alternarMenu(false);
      return;
    }

    // El foco no se escapa del menú abierto mientras se tabula.
    if (e.key === 'Tab') {
      const lista = enfocables();
      if (lista.length === 0) return;
      const primero = lista[0];
      const ultimo = lista[lista.length - 1];
      const activo = document.activeElement;

      if (e.shiftKey && (activo === primero || !menu.contains(activo))) {
        e.preventDefault();
        ultimo.focus();
      } else if (!e.shiftKey && (activo === ultimo || !menu.contains(activo))) {
        e.preventDefault();
        primero.focus();
      }
    }
  });
</script>
