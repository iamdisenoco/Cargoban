---
import { navegacion, empresa } from '../data/sitio';
---

<header
  id="cabecera"
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,backdrop-filter,border-color] duration-500"
>
  <div class="contenedor flex h-20 items-center justify-between gap-6 lg:h-24">
    <a href="#inicio" class="shrink-0" aria-label={`${empresa.nombre}, ir al inicio`}>
      <img
        src="/marca/logo-horizontal-blanco.svg"
        alt=""
        width="220"
        height="60"
        class="h-9 w-auto lg:h-11"
      />
    </a>

    <nav class="hidden items-center gap-10 lg:flex" aria-label="Principal">
      {navegacion.map((item) => (
        <a
          href={item.href}
          class="group relative font-display text-sm font-medium text-white/85 transition-colors hover:text-white"
        >
          {item.etiqueta}
          <span class="absolute -bottom-1.5 left-0 h-px w-0 bg-green transition-all duration-300 ease-suave group-hover:w-full"></span>
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="#contacto"
        class="hidden rounded-full bg-green px-6 py-2.5 font-display text-sm font-semibold text-navy-950 transition-colors hover:bg-green-300 lg:inline-flex"
      >
        Cotizar operación
      </a>

      <button
        id="menu-boton"
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-full border border-white/25 text-white transition-colors hover:bg-white/10 lg:hidden"
        aria-controls="menu-movil"
        aria-expanded="false"
      >
        <span class="sr-only" id="menu-boton-texto">Abrir menú</span>
        <svg
          id="menu-icono-abrir"
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          aria-hidden="true"
        >
          <path stroke-linecap="round" d="M3 7h18M3 12h18M3 17h18" />
        </svg>
        <svg
          id="menu-icono-cerrar"
          class="hidden size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          aria-hidden="true"
        >
          <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Menú móvil a pantalla completa -->
<div
  id="menu-movil"
  class="fixed inset-0 z-40 hidden bg-navy-950/98 backdrop-blur-xl lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
>
  <nav class="contenedor flex h-full flex-col justify-center gap-2" aria-label="Principal móvil">
    {navegacion.map((item, i) => (
      <a
        href={item.href}
        class="flex items-baseline gap-5 border-b border-white/10 py-5 font-display text-4xl font-semibold text-white transition-colors hover:text-green sm:text-5xl"
      >
        <span class="font-sans text-xs text-green">{String(i + 1).padStart(2, '0')}</span>
        {item.etiqueta}
      </a>
    ))}
    <a
      href="#contacto"
      class="mt-8 inline-flex justify-center rounded-full bg-green px-8 py-4 font-display text-base font-semibold text-navy-950"
    >
      Cotizar operación
    </a>
  </nav>
</div>

<script>
  const cabecera = document.getElementById('cabecera');
  const boton = document.getElementById('menu-boton');
  const botonTexto = document.getElementById('menu-boton-texto');
  const iconoAbrir = document.getElementById('menu-icono-abrir');
  const iconoCerrar = document.getElementById('menu-icono-cerrar');
  const menu = document.getElementById('menu-movil');

  /*
    La cabecera se vuelve sólida en cuanto el contenido empieza a pasar por detrás.
    El centinela ocupa exactamente la franja que cubre la cabecera al inicio de la
    página: mientras una parte de esa franja siga a la vista, no hemos bajado lo
    suficiente. No depende de la altura del hero, que cambia con el contenido.
  */
  const centinela = document.getElementById('centinela-cabecera');
  if (centinela && cabecera) {
    new IntersectionObserver(([entrada]) => {
      const solido = !entrada.isIntersecting;
      cabecera.classList.toggle('bg-navy-950/90', solido);
      cabecera.classList.toggle('backdrop-blur-lg', solido);
      cabecera.classList.toggle('border-b', solido);
      cabecera.classList.toggle('border-white/10', solido);
    }).observe(centinela);
  }

  // Elementos que pueden recibir foco dentro del menú abierto.
  function enfocables(): HTMLElement[] {
    return Array.from(menu?.querySelectorAll<HTMLElement>('a[href], button') ?? []);
  }

  function alternarMenu(abrir: boolean) {
    menu?.classList.toggle('hidden', !abrir);
    boton?.setAttribute('aria-expanded', String(abrir));
    iconoAbrir?.classList.toggle('hidden', abrir);
    iconoCerrar?.classList.toggle('hidden', !abrir);
    if (botonTexto) botonTexto.textContent = abrir ? 'Cerrar menú' : 'Abrir menú';
    document.body.style.overflow = abrir ? 'hidden' : '';
    if (abrir) enfocables()[0]?.focus();
    else boton?.focus();
  }

  boton?.addEventListener('click', () => alternarMenu(menu?.classList.contains('hidden') ?? true));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => alternarMenu(false)));

  // Tocar el fondo cierra el menú: en un teléfono no hay tecla de escape.
  menu?.addEventListener('click', (e) => {
    if (e.target === menu) alternarMenu(false);
  });

  document.addEventListener('keydown', (e) => {
    if (!menu || menu.classList.contains('hidden')) return;

    if (e.key === 'Escape') {
      alternarMenu(false);
      return;
    }

    // El foco no se escapa del menú abierto mientras se tabula.
    if (e.key === 'Tab') {
      const lista = enfocables();
      if (lista.length === 0) return;
      const primero = lista[0];
      const ultimo = lista[lista.length - 1];
      const activo = document.activeElement;

      if (e.shiftKey && (activo === primero || !menu.contains(activo))) {
        e.preventDefault();
        ultimo.focus();
      } else if (!e.shiftKey && (activo === ultimo || !menu.contains(activo))) {
        e.preventDefault();
        primero.focus();
      }
    }
  });
</script>
