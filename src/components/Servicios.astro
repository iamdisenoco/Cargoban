---
import Titular from './Titular.astro';
import { servicios, tiposDeCarga } from '../data/sitio';
---

<section id="servicios" class="relative isolate scroll-mt-24 bg-navy-950 py-24 lg:py-36">
  <!--
    Fondo: un tramo corto de video propio (DJI_0587, operarios junto a un contenedor) que va
    y vuelve en bucle. Queda fijo detrás mientras se recorre la sección.
    El video está recortado para dejar fuera la grúa y desenfocado a propósito: en el chasis
    del remolque hay un rótulo de Puerto Antioquia, y su marca no puede leerse (AGENTS.md).
    Versión alta para pantallas verticales, ancha para el resto. Quien pidió menos
    movimiento ve la imagen fija.
  -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="sticky top-0 h-[100svh] overflow-hidden">
      <picture>
        <source srcset="/video/servicios-alto.jpg" media="(max-aspect-ratio: 1/1)" />
        <img src="/video/servicios-ancho.jpg" alt="" class="absolute inset-0 size-full object-cover" />
      </picture>
      <video
        class="video-servicios absolute inset-0 size-full object-cover"
        muted
        loop
        playsinline
        preload="none"
        tabindex="-1"
      >
        <source src="/video/servicios-alto.webm" type="video/webm" media="(max-aspect-ratio: 1/1)" />
        <source src="/video/servicios-alto.mp4" type="video/mp4" media="(max-aspect-ratio: 1/1)" />
        <source src="/video/servicios-ancho.mp4" type="video/mp4" />
        <source src="/video/servicios-ancho.webm" type="video/webm" />
      </video>
      <div class="absolute inset-0 bg-navy-950/80"></div>
    </div>
  </div>
  <div class="contenedor">
    <div class="revelar flex flex-col gap-8 border-b border-white/15 pb-10 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <Titular
          texto="Nuestros servicios"
          class="max-w-[14ch] text-white"
          style="font-size:var(--text-titulo)"
        />
      </div>
      <p class="max-w-md text-white/65">
        Cuatro frentes de operación que se sostienen entre sí. La carga no cambia de manos
        entre un proveedor y otro: se queda con nosotros.
      </p>
    </div>
  </div>

  <!--
    Paneles apilados: cada servicio queda fijo mientras el siguiente sube
    y se monta encima. El desplazamiento escalonado deja ver el borde del anterior.
  -->
  <div class="contenedor mt-4">
    {servicios.map((servicio, i) => (
      <article
        class="panel-apilado overflow-hidden rounded-2xl border border-white/12 bg-navy-900/90 backdrop-blur-md lg:rounded-3xl"
        style={`--desplazamiento-apilado:calc(8rem + ${i * 1.25}rem); margin-top:${i === 0 ? '2rem' : '1.5rem'}`}
      >
        <div class="grid gap-8 p-7 sm:p-10 lg:grid-cols-12 lg:gap-12 lg:p-14">
          <div class="lg:col-span-5">
            <div class="flex items-start gap-5">
              <span class="cifra font-display text-sm font-semibold text-teal-400">{servicio.numero}</span>
              <div>
                <h3 class="text-white" style="font-size:var(--text-subtitulo)">{servicio.titulo}</h3>
                <p class="mt-4 text-white/60">{servicio.resumen}</p>
              </div>
            </div>
          </div>

          <div class="lg:col-span-7">
            <p class="max-w-prose text-white/80" style="font-size:var(--text-cuerpo-lg)">
              {servicio.detalle}
            </p>

            <ul class="mt-8 grid gap-x-10 gap-y-3 sm:grid-cols-2">
              {servicio.items.map((item) => (
                <li class="flex items-start gap-3 border-t border-white/10 pt-3 text-white/85">
                  <span class="mt-2 size-1.5 shrink-0 rotate-45 bg-white/40" aria-hidden="true"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Franja inferior de color, distinta por servicio -->
        <div
          class="h-1 w-full"
          style={`background:linear-gradient(to right, var(--color-${i % 2 === 0 ? 'teal' : 'green'}), transparent 70%)`}
          aria-hidden="true"
        >
        </div>
      </article>
    ))}
  </div>

  <!-- Tipos de carga: antes era una sección aparte; Jon la pidió dentro de Servicios (25/09). -->
  <div id="carga" class="contenedor scroll-mt-24 pt-24 lg:pt-32">
    <div class="revelar grid gap-8 border-b border-white/15 pb-10 lg:grid-cols-12 lg:items-end">
      <h3 class="text-white lg:col-span-7" style="font-size:var(--text-subtitulo)">
        Experiencia en todo tipo de carga
      </h3>
      <p class="max-w-md text-white/65 lg:col-span-5">
        Desde contenedores refrigerados hasta carga de proyecto, aplicamos a cada tipo de
        carga el procedimiento, los equipos y el personal que requiere.
      </p>
    </div>

    <ul class="revelar mt-10 grid gap-px overflow-hidden rounded-2xl bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
      {tiposDeCarga.map((tipo, i) => (
        <li class="group relative flex flex-col gap-6 bg-navy-900 p-7 transition-colors duration-300 hover:bg-navy-950 lg:gap-10 lg:p-8">
          <span class="cifra font-sans text-xs text-white/55">{String(i + 1).padStart(2, '0')}</span>
          <span class="font-display text-xl font-semibold text-white lg:text-2xl">{tipo}</span>
          <span
            class="absolute inset-x-7 bottom-0 h-px w-0 bg-green transition-all duration-500 ease-suave group-hover:w-[calc(100%-3.5rem)]"
            aria-hidden="true"
          >
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // El video solo se carga y corre cuando la sección está cerca de la pantalla, y nunca
  // para quien pidió menos movimiento: ahí queda la imagen fija de debajo.
  const video = document.querySelector<HTMLVideoElement>('.video-servicios');
  const quieto = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (video && !quieto.matches && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      ([entrada]) => {
        if (entrada.isIntersecting) {
          if (video.preload === 'none') {
            video.preload = 'auto';
            video.load();
          }
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      },
      { rootMargin: '200px 0px' },
    ).observe(video.closest('section')!);
  }
</script>
