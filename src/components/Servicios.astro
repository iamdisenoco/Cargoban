---
import Titular from './Titular.astro';
import { servicios } from '../data/sitio';
---

<section id="servicios" class="scroll-mt-24 bg-paper py-24 lg:py-36">
  <div class="contenedor">
    <div class="revelar flex flex-col gap-8 border-b border-ink/10 pb-10 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <Titular
          texto="De la bodega del buque a la puerta del cliente"
          class="max-w-[14ch] text-ink"
          style="font-size:var(--text-titulo)"
        />
      </div>
      <p class="max-w-md text-ink-soft">
        Cuatro frentes de operación que se sostienen entre sí. La carga no cambia de manos
        entre un proveedor y otro: se queda con nosotros.
      </p>
    </div>
  </div>

  <!--
    Paneles apilados: cada servicio queda fijo mientras el siguiente sube
    y se monta encima. El desplazamiento escalonado deja ver el borde del anterior.
  -->
  <div class="contenedor mt-4">
    {servicios.map((servicio, i) => (
      <article
        class="panel-apilado overflow-hidden rounded-2xl border border-ink/10 bg-white lg:rounded-3xl"
        style={`--desplazamiento-apilado:calc(8rem + ${i * 1.25}rem); margin-top:${i === 0 ? '2rem' : '1.5rem'}`}
      >
        <div class="grid gap-8 p-7 sm:p-10 lg:grid-cols-12 lg:gap-12 lg:p-14">
          <div class="lg:col-span-5">
            <div class="flex items-start gap-5">
              <span class="cifra font-display text-sm font-semibold text-navy">{servicio.numero}</span>
              <div>
                <h3 class="text-ink" style="font-size:var(--text-subtitulo)">{servicio.titulo}</h3>
                <p class="mt-4 text-ink-soft">{servicio.resumen}</p>
              </div>
            </div>
          </div>

          <div class="lg:col-span-7">
            <p class="max-w-prose text-ink" style="font-size:var(--text-cuerpo-lg)">
              {servicio.detalle}
            </p>

            <ul class="mt-8 grid gap-x-10 gap-y-3 sm:grid-cols-2">
              {servicio.items.map((item) => (
                <li class="flex items-start gap-3 border-t border-ink/10 pt-3 text-ink">
                  <span class="mt-2 size-1.5 shrink-0 rotate-45 bg-teal" aria-hidden="true"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Franja inferior de color, distinta por servicio -->
        <div
          class="h-1 w-full"
          style={`background:linear-gradient(to right, var(--color-${i % 2 === 0 ? 'teal' : 'green'}), transparent 70%)`}
          aria-hidden="true"
        >
        </div>
      </article>
    ))}
  </div>
</section>
