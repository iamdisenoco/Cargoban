---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Cinta from '../components/Cinta.astro';
import Servicios from '../components/Servicios.astro';
import Titular from '../components/Titular.astro';
import { empresa, razones, cifras, fundacion, clientes, sedes } from '../data/sitio';
---

<Base>
  <Hero />
  <Cinta />

  <!-- Nosotros -->
  <section id="nosotros" class="scroll-mt-24 bg-navy-950 py-24 lg:py-36">
    <div class="contenedor grid gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="revelar lg:col-span-5">
        <Titular
          texto="Experiencia que respalda cada operación"
          class="text-white"
          style="font-size:var(--text-titulo)"
        />
      </div>

      <div class="revelar lg:col-span-7">
        <p class="text-white" style="font-size:var(--text-cuerpo-lg)">
          Cargoban es un operador logístico y portuario colombiano con más
          de {empresa.anios} años de trayectoria. Desde {empresa.sedes.join(' y ')} acompañamos
          a nuestros clientes en cada etapa de la operación: del buque al patio y del puerto
          a la bodega.
        </p>
        <p class="mt-6 max-w-prose text-white/65">
          Trabajamos con personal propio y especializado, procedimientos estandarizados y
          control de cada movimiento, para que la carga llegue a su destino en las mismas
          condiciones en que nos fue entregada.
        </p>

        <!-- Cifras: cuentan hacia arriba al entrar en pantalla (src/scripts/contadores.ts).
             El número final va escrito en el HTML: sin JavaScript se lee igual. -->
        <dl class="mt-12 grid gap-px overflow-hidden rounded-2xl bg-white/10 sm:grid-cols-3">
          {cifras.map((cifra) => (
            <div class="flex flex-col-reverse gap-2 bg-navy-950 p-7 lg:p-8">
              <dt class="text-sm text-white/65">{cifra.texto}</dt>
              <dd
                class="cifra font-display text-4xl font-semibold leading-none text-white lg:text-5xl"
                data-contador={cifra.valor}
                data-prefijo={cifra.prefijo}
              >
                {cifra.prefijo}{cifra.valor.toLocaleString('es-CO')}
              </dd>
            </div>
          ))}
        </dl>

        <ul class="mt-6 grid gap-px overflow-hidden rounded-2xl bg-white/10 sm:grid-cols-2">
          {razones.map((razon) => (
            <li class="bg-navy-950 p-7 lg:p-8">
              <span class="block size-2 rotate-45 bg-teal-400" aria-hidden="true"></span>
              <h3 class="mt-5 font-display text-lg font-semibold text-white">{razon.titulo}</h3>
              <p class="mt-3 text-sm leading-relaxed text-white/60">{razon.texto}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Servicios />


  <!-- Sostenibilidad: Fundación Cargoban. Contenido PROVISIONAL (ver src/data/sitio.ts). -->
  <section id="sostenibilidad" class="scroll-mt-24 bg-navy-950 py-24 lg:py-36">
    <div class="contenedor grid gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="revelar lg:col-span-5">
        <Titular
          texto="Compromiso con las comunidades donde operamos"
          class="text-white"
          style="font-size:var(--text-titulo)"
        />
      </div>

      <div class="revelar lg:col-span-7">
        <p class="text-white" style="font-size:var(--text-cuerpo-lg)">
          Desde {fundacion.desde}, la {fundacion.nombre} desarrolla proyectos sociales
          sostenibles que mejoran la calidad de vida de comunidades vulnerables
          en {empresa.sedes.join(' y ')}.
        </p>
        <p class="mt-6 max-w-prose text-white/65">
          Nació en el Urabá antioqueño como iniciativa de Cargoban para responder a
          necesidades de educación, vivienda y espacios de encuentro en la región.
        </p>

        <ul class="mt-12 grid gap-px overflow-hidden rounded-2xl bg-white/10 sm:grid-cols-2">
          {fundacion.lineas.map((linea, i, todas) => (
            // Con un número impar de líneas, la última ocupa la fila entera: sin celda vacía.
            <li
              class:list={[
                'flex items-center gap-4 bg-navy-950 px-7 py-6',
                { 'sm:col-span-2': i === todas.length - 1 && todas.length % 2 === 1 },
              ]}
            >
              <span class="block size-2 shrink-0 rotate-45 bg-green" aria-hidden="true"></span>
              <span class="font-display text-lg font-semibold text-white">{linea}</span>
            </li>
          ))}
        </ul>

        <a
          href={fundacion.web}
          target="_blank"
          rel="noopener"
          class="group mt-10 inline-flex items-center gap-3 rounded-full border border-white/30 px-7 py-4 font-display font-semibold text-white transition-colors hover:bg-white/10"
        >
          Conocer la {fundacion.nombre}
          <svg class="size-4 transition-transform duration-300 ease-suave group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path d="M2 8h12M9 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="sr-only">(se abre en una pestaña nueva)</span>
        </a>
      </div>
    </div>
  </section>

  {/* La sección de clientes solo se muestra cuando Cargoban entregue la lista. */}
  {clientes.length > 0 && (
    <section id="clientes" class="scroll-mt-24 bg-navy-950 py-24 lg:py-36">
      <div class="contenedor">
        <div class="revelar max-w-3xl">
          <Titular
            texto="Quienes nos confían su carga"
            class="text-white"
            style="font-size:var(--text-titulo)"
          />
        </div>

        <ul class="revelar mt-16 grid grid-cols-2 items-center gap-px overflow-hidden rounded-2xl bg-white/10 sm:grid-cols-3 lg:grid-cols-5">
          {clientes.map((cliente) => (
            <li class="flex min-h-32 items-center justify-center bg-navy-950 p-8">
              {cliente.logo ? (
                <img
                  src={cliente.logo}
                  alt={cliente.nombre}
                  class="max-h-10 w-auto opacity-60 brightness-0 invert transition-opacity hover:opacity-100"
                />
              ) : (
                <span class="text-center font-display font-semibold text-white/70">{cliente.nombre}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Contacto -->
  <section id="contacto" class="scroll-mt-24 relative isolate overflow-hidden bg-navy py-24 lg:py-36">
    <div
      class="absolute inset-0 -z-10 opacity-[0.04]"
      style="background-image:url('/marca/isotipo-blanco.svg');background-size:clamp(52px,5vw,84px);background-repeat:repeat"
      aria-hidden="true"
    >
    </div>

    <div class="contenedor grid gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="revelar lg:col-span-6">
        <Titular
          texto="Cuéntenos qué necesita mover"
          class="max-w-[12ch] text-white"
          style="font-size:var(--text-titulo)"
        />
        <p class="mt-8 max-w-md text-white/75" style="font-size:var(--text-cuerpo-lg)">
          Escríbanos con el tipo de carga, el puerto y las fechas. Le respondemos con una
          propuesta de operación.
        </p>

        {empresa.correo || empresa.telefono ? (
          <div class="mt-10 flex flex-wrap gap-4">
            {empresa.correo && (
              <a
                href={`mailto:${empresa.correo}`}
                class="inline-flex items-center rounded-full bg-green px-7 py-4 font-display font-semibold text-navy-950 transition-colors hover:bg-green-300"
              >
                {empresa.correo}
              </a>
            )}
            {empresa.telefono && (
              <a
                href={`tel:${empresa.telefono.replace(/\s/g, '')}`}
                class="inline-flex items-center rounded-full border border-white/30 px-7 py-4 font-display font-semibold text-white transition-colors hover:bg-white/10"
              >
                {empresa.telefono}
              </a>
            )}
          </div>
        ) : (
          <p class="mt-10 max-w-md text-sm text-white/60">
            Estamos habilitando los canales de contacto de la nueva página.
            Mientras tanto puede escribirnos por nuestras redes sociales.
          </p>
        )}
      </div>

      <ul class="revelar grid gap-6 lg:col-span-6">
        {sedes.map((sede) => (
          <li class="rounded-2xl border border-white/15 bg-navy-900 p-8">
            <h3 class="font-display text-3xl font-semibold text-white">{sede.ciudad}</h3>
            <p class="mt-2 text-white/60">{sede.region}</p>
            {(sede.direccion || sede.telefono) && (
              <dl class="mt-6 space-y-2 text-sm">
                {sede.direccion && (
                  <div class="flex gap-3">
                    <dt class="w-20 shrink-0 text-white/60">Dirección</dt>
                    <dd class="text-white/80">{sede.direccion}</dd>
                  </div>
                )}
                {sede.telefono && (
                  <div class="flex gap-3">
                    <dt class="w-20 shrink-0 text-white/60">Teléfono</dt>
                    <dd class="text-white/80">{sede.telefono}</dd>
                  </div>
                )}
              </dl>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
