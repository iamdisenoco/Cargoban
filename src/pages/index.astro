---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Cinta from '../components/Cinta.astro';
import Servicios from '../components/Servicios.astro';
import Titular from '../components/Titular.astro';
import { empresa, razones, cifras, fundacion, fondecar, clientes, sedes } from '../data/sitio';
---

<Base>
  <!--
    Escena de apertura, como cargokite: la portada queda fija (sticky) y la cinta
    con "Nosotros" sube encima como una cortina. Mientras sube, el texto de la
    portada se va hacia arriba y el fondo baja un poco (global.css, .portada-escena).
    En pantallas angostas o bajas no hay cortina: el scroll es el normal.
  -->
  <div class="portada-escena relative">
    <!--
      Centinela de la cabecera: ocupa la franja que la cabecera cubre al inicio de la
      página. Mientras parte de esa franja se vea, la cabecera queda transparente.
      Va aquí y no dentro de la portada: la portada queda fija y el centinela nunca saldría.
    -->
    <div id="centinela-cabecera" class="pointer-events-none absolute inset-x-0 top-0 h-20 lg:h-24" aria-hidden="true"></div>
    <Hero />

    <div class="portada-cortina">
      <Cinta />

      <!-- Nosotros: tres filas a todo el ancho para que ninguna columna quede colgando.
           1) titular y foto vertical | foto horizontal y presentación
           2) cifras en una franja   3) las cuatro razones en una fila -->
      <section id="nosotros" class="scroll-mt-24 bg-white py-24 text-ink lg:py-36">
        <div class="contenedor">
          <div class="grid gap-14 lg:grid-cols-12 lg:gap-x-20">
            <div class="flex flex-col lg:col-span-5">
              <Titular
                texto="Bienvenido a *Cargoban*"
                class="text-navy"
                style="font-size:var(--text-titulo)"
              />
              <figure class="foto-abre mt-12 hidden aspect-[4/5] overflow-hidden rounded-2xl lg:block">
                <img
                  src="/fotos/nosotros-caminando.webp"
                  alt="Supervisor de Cargoban caminando por el muelle frente a las grúas pórtico"
                  class="size-full object-cover object-[50%_58%]"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            </div>

            <div class="flex flex-col lg:col-span-7 lg:pt-40">
              <figure class="foto-abre aspect-[4/3] overflow-hidden rounded-2xl">
                <!-- Recortada arriba (la grúa lleva la marca de Puerto Antioquia) y con dos rótulos
                     del chasis desenfocados. Original: IMG_2894 en la carpeta de Drive de Jon. -->
                <img
                  src="/fotos/nosotros-maersk.webp"
                  alt="Operarios de Cargoban junto a un contenedor refrigerado en el muelle"
                  class="size-full object-cover object-[50%_25%]"
                  loading="lazy"
                  decoding="async"
                />
              </figure>

              <p class="revelar mt-12 max-w-2xl font-display font-semibold text-navy" style="font-size:var(--text-subtitulo);line-height:1.2;letter-spacing:-0.02em">
                Somos un operador logístico y portuario colombiano con más de {empresa.anios} años
                de trayectoria en {empresa.sedes.join(' y ')}.
              </p>
              <p class="revelar mt-6 max-w-2xl text-ink-soft" style="font-size:var(--text-cuerpo-lg)">
                Acompañamos a nuestros clientes en cada etapa de la operación: cargue y descargue
                de buques, manejo de carga en muelle, transporte, almacenamiento y alquiler de
                equipos, con personal propio y especializado, procedimientos estandarizados y
                control de cada movimiento.
              </p>
            </div>
          </div>

          <!-- Cifras: cuentan hacia arriba al entrar en pantalla (src/scripts/contadores.ts).
               El número final va escrito en el HTML: sin JavaScript se lee igual. -->
          <dl class="revelar mt-24 grid border-y border-ink/10 sm:grid-cols-3 lg:mt-32">
            {cifras.map((cifra, i) => (
              <div
                class:list={[
                  'flex flex-col-reverse gap-3 py-10 sm:px-8 lg:py-14',
                  i > 0 && 'border-t border-ink/10 sm:border-t-0 sm:border-l',
                  i === 0 && 'sm:pl-0',
                ]}
              >
                <dt class="text-ink-soft">{cifra.texto}</dt>
                <dd
                  class="cifra font-display font-semibold leading-none text-navy"
                  style="font-size:clamp(3rem,2rem + 3.5vw,5.5rem);letter-spacing:-0.035em"
                  data-contador={cifra.valor}
                  data-prefijo={cifra.prefijo}
                >
                  {cifra.prefijo}{cifra.valor.toLocaleString('es-CO')}
                </dd>
              </div>
            ))}
          </dl>

          <ul class="revelar mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:mt-20 lg:grid-cols-4">
            {razones.map((razon) => (
              <li class="border-t border-ink/15 pt-6">
                <span class="block size-2 rotate-45 bg-teal" aria-hidden="true"></span>
                <h3 class="mt-5 font-display text-xl font-semibold text-ink">{razon.titulo}</h3>
                <p class="mt-3 leading-relaxed text-ink-soft">{razon.texto}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </div>
  </div>

  <Servicios />


  <!-- Sostenibilidad: Fundación Cargoban. Textos PROVISIONALES (ver src/data/sitio.ts).
       Fotos: carpeta «Cargoban fundación» del Drive de Jon (25/09). Hay menores
       identificables: confirmar con la fundación el permiso de uso antes de publicar. -->
  <section id="sostenibilidad" class="scroll-mt-24 bg-navy-950 py-24 lg:py-36">
    <div class="contenedor">
      <!-- El titular va a lo ancho, en dos líneas: en una columna angosta quedaba
           partido en cinco renglones gigantes (Jon, 25/09). -->
      <Titular
        texto="Compromiso con las *comunidades* donde operamos"
        class="max-w-[24ch] text-white"
        style="font-size:var(--text-seccion)"
      />

      <div class="mt-14 grid gap-12 lg:mt-20 lg:grid-cols-12 lg:gap-x-20">
        <figure class="foto-abre aspect-square overflow-hidden rounded-2xl lg:col-span-5">
          <img
            src="/fotos/fundacion-nina.webp"
            alt="Niña de una comunidad acompañada por la Fundación Cargoban"
            class="size-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div class="lg:col-span-7 lg:self-center">
          <p class="revelar font-display font-medium text-white" style="font-size:clamp(1.25rem, 1rem + 0.9vw, 1.75rem);line-height:1.3;letter-spacing:-0.015em">
            Desde {fundacion.desde}, la {fundacion.nombre} desarrolla proyectos sociales
            sostenibles que <span class="text-green">mejoran la calidad de vida</span> de
            comunidades vulnerables en {fundacion.regiones.join(' y ')}.
          </p>
          <p class="revelar mt-6 max-w-prose text-white/65" style="font-size:var(--text-cuerpo-lg)">
            Nació en el Urabá antioqueño como iniciativa de Cargoban para responder a
            necesidades de educación, emprendimiento y espacios de encuentro en la región.
          </p>

          <ul class="revelar mt-12 grid gap-x-10 sm:grid-cols-2">
            {fundacion.lineas.map((linea) => (
              <li class="flex items-center gap-4 border-t border-white/15 py-5">
                <span class="block size-2 shrink-0 rotate-45 bg-green" aria-hidden="true"></span>
                <span class="font-display text-lg font-semibold text-white">{linea}</span>
              </li>
            ))}
          </ul>

          {fundacion.web && (
          <a
            href={fundacion.web}
            target="_blank"
            rel="noopener"
            class="group mt-10 inline-flex items-center gap-3 rounded-full border border-white/30 px-7 py-4 font-display font-semibold text-white transition-colors hover:bg-white/10"
          >
            Conocer la {fundacion.nombre}
            <svg class="size-4 transition-transform duration-300 ease-suave group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path d="M2 8h12M9 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="sr-only">(se abre en una pestaña nueva)</span>
          </a>
          )}
        </div>
      </div>

      <!-- Franja de fotos de los proyectos -->
      <ul class="mt-20 grid grid-cols-2 gap-4 lg:mt-28 lg:grid-cols-4 lg:gap-6">
        {[
          { src: '/fotos/fundacion-taller.webp', alt: 'Mujer sonriendo durante un taller de la fundación' },
          { src: '/fotos/fundacion-sonrisa.webp', alt: 'Niña sonriendo junto a su familia' },
          { src: '/fotos/fundacion-pintura.webp', alt: 'Joven pintando en un taller de arte' },
          { src: '/fotos/fundacion-mural.webp', alt: 'Mural de un perezoso en una casa de la región' },
        ].map((foto) => (
          <li class="foto-abre aspect-[3/4] overflow-hidden rounded-2xl">
            <img src={foto.src} alt={foto.alt} class="size-full object-cover" loading="lazy" decoding="async" />
          </li>
        ))}
      </ul>

      <!-- Fondo de empleados. Foto: colaboradora de Cargoban en muelle (Drive de Jon, 25/09). -->
      <div class="mt-24 grid gap-12 border-t border-white/15 pt-24 lg:mt-36 lg:grid-cols-12 lg:gap-x-20 lg:pt-36">
        <div class="lg:col-span-5 lg:self-center">
          <h3 class="revelar font-display font-semibold text-white" style="font-size:var(--text-subtitulo);line-height:1.1;letter-spacing:-0.03em">
            Fondo de empleados <span class="text-green">{fondecar.nombre}</span>
          </h3>
          <p class="revelar mt-6 max-w-prose text-white/65" style="font-size:var(--text-cuerpo-lg)">
            Nuestro fondo de empleados brinda soluciones para <span class="text-white">mejorar
            la calidad de vida</span> de los asociados y sus familias.
          </p>
          <ul class="revelar mt-10">
            {fondecar.beneficios.map((beneficio) => (
              <li class="flex items-center gap-4 border-t border-white/15 py-4 last:border-b">
                <span class="block size-2 shrink-0 rotate-45 bg-green" aria-hidden="true"></span>
                <span class="font-display text-lg font-semibold text-white">{beneficio}</span>
              </li>
            ))}
          </ul>
        </div>
        <figure class="foto-abre order-first aspect-[4/3] overflow-hidden rounded-2xl lg:col-span-7">
          <img
            src="/fotos/fondecar-colaboradora.webp"
            alt="Colaboradora de Cargoban con casco y gafas de seguridad en el muelle"
            class="size-full object-cover"
            style="object-position:55% 40%"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  {/* La sección de clientes solo se muestra cuando Cargoban entregue la lista. */}
  {clientes.length > 0 && (
    <section id="clientes" class="scroll-mt-24 bg-navy-950 py-24 lg:py-36">
      <div class="contenedor">
        <div class="revelar max-w-3xl">
          <Titular
            texto="Quienes nos confían su carga"
            class="text-white"
            style="font-size:var(--text-titulo)"
          />
        </div>

        <ul class="revelar mt-16 grid grid-cols-2 items-center gap-px overflow-hidden rounded-2xl bg-white/10 sm:grid-cols-3 lg:grid-cols-5">
          {clientes.map((cliente) => (
            <li class="flex min-h-32 items-center justify-center bg-navy-950 p-8">
              {cliente.logo ? (
                <img
                  src={cliente.logo}
                  alt={cliente.nombre}
                  class="max-h-10 w-auto opacity-60 brightness-0 invert transition-opacity hover:opacity-100"
                />
              ) : (
                <span class="text-center font-display font-semibold text-white/70">{cliente.nombre}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Contacto -->
  <section id="contacto" class="scroll-mt-24 relative isolate overflow-hidden bg-navy py-24 lg:py-36">
    <div
      class="absolute inset-0 -z-10 opacity-[0.04]"
      style="background-image:url('/marca/isotipo-blanco.svg');background-size:clamp(52px,5vw,84px);background-repeat:repeat"
      aria-hidden="true"
    >
    </div>

    <div class="contenedor grid gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="revelar lg:col-span-6">
        <Titular
          texto="Cuéntenos qué necesita mover"
          class="max-w-[12ch] text-white"
          style="font-size:var(--text-titulo)"
        />
        <p class="mt-8 max-w-md text-white/75" style="font-size:var(--text-cuerpo-lg)">
          Escríbanos con el tipo de carga, el puerto y las fechas. Le respondemos con una
          propuesta de operación.
        </p>

        {empresa.correo || empresa.telefono ? (
          <div class="mt-10 flex flex-wrap gap-4">
            {empresa.correo && (
              <a
                href={`mailto:${empresa.correo}`}
                class="inline-flex items-center rounded-full bg-green px-7 py-4 font-display font-semibold text-navy-950 transition-colors hover:bg-green-300"
              >
                {empresa.correo}
              </a>
            )}
            {empresa.telefono && (
              <a
                href={`tel:${empresa.telefono.replace(/\s/g, '')}`}
                class="inline-flex items-center rounded-full border border-white/30 px-7 py-4 font-display font-semibold text-white transition-colors hover:bg-white/10"
              >
                {empresa.telefono}
              </a>
            )}
          </div>
        ) : (
          <p class="mt-10 max-w-md text-sm text-white/60">
            Estamos habilitando los canales de contacto de la nueva página.
            Mientras tanto puede escribirnos por nuestras redes sociales.
          </p>
        )}
      </div>

      <ul class="revelar grid gap-6 lg:col-span-6">
        {sedes.map((sede) => (
          <li class="rounded-2xl border border-white/15 bg-navy-900 p-8">
            <h3 class="font-display text-3xl font-semibold text-white">{sede.ciudad}</h3>
            <p class="mt-2 text-white/60">{sede.region}</p>
            {(sede.direccion || sede.telefono) && (
              <dl class="mt-6 space-y-2 text-sm">
                {sede.direccion && (
                  <div class="flex gap-3">
                    <dt class="w-20 shrink-0 text-white/60">Dirección</dt>
                    <dd class="text-white/80">{sede.direccion}</dd>
                  </div>
                )}
                {sede.telefono && (
                  <div class="flex gap-3">
                    <dt class="w-20 shrink-0 text-white/60">Teléfono</dt>
                    <dd class="text-white/80">{sede.telefono}</dd>
                  </div>
                )}
              </dl>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
