---
import Base from '../layouts/Base.astro';
import { empresa, servicios, clientes, porQue } from '../data/sitio';
---

<Base>
  <!-- Inicio -->
  <section id="inicio" class="relative overflow-hidden bg-navy text-white">
    <div class="absolute inset-0 opacity-[0.06] bg-[url('/marca/isotipo-blanco.svg')] bg-[length:140px] bg-repeat" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-24 md:py-36">
      <p class="font-display font-semibold text-green uppercase tracking-widest text-sm">{empresa.lema}</p>
      <h1 class="mt-4 text-white text-4xl md:text-6xl font-bold max-w-3xl leading-tight">
        Más de {empresa.anios} años moviendo la carga de Colombia
      </h1>
      <p class="mt-6 text-lg md:text-xl text-white/85 max-w-2xl">
        Operación logística y portuaria en {empresa.sedes.join(' y ')}, con personal experimentado,
        procedimientos establecidos y trazabilidad en cada movimiento.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="/#servicios" class="inline-flex items-center rounded-md bg-green px-6 py-3 font-display font-semibold text-navy hover:bg-green-dark transition-colors">
          Ver servicios
        </a>
        <a href="/#contacto" class="inline-flex items-center rounded-md border border-white/40 px-6 py-3 font-display font-semibold text-white hover:bg-white/10 transition-colors">
          Contactar
        </a>
      </div>
    </div>
  </section>

  <!-- Nosotros -->
  <section id="nosotros" class="scroll-mt-20 py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 grid gap-12 lg:grid-cols-2 lg:items-start">
      <div>
        <p class="font-display font-semibold text-teal uppercase tracking-widest text-sm">Nosotros</p>
        <h2 class="mt-3 text-3xl md:text-4xl font-bold">Un operador con historia en los puertos del Caribe colombiano</h2>
        <p class="mt-6 text-ink-soft leading-relaxed">
          Cargoban es un operador logístico y portuario con más de {empresa.anios} años de trayectoria,
          presente en {empresa.sedes.join(' y ')}. Texto institucional pendiente de confirmar con la empresa.
        </p>
      </div>
      <ul class="grid gap-6 sm:grid-cols-2">
        {porQue.map((item) => (
          <li class="rounded-lg border border-ink-faint/40 p-6">
            <span class="inline-block size-2.5 rounded-full bg-green" aria-hidden="true"></span>
            <h3 class="mt-3 font-semibold text-lg">{item.titulo}</h3>
            <p class="mt-2 text-sm text-ink-soft leading-relaxed">{item.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Servicios -->
  <section id="servicios" class="scroll-mt-20 bg-paper py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="font-display font-semibold text-teal uppercase tracking-widest text-sm">Servicios</p>
      <h2 class="mt-3 text-3xl md:text-4xl font-bold max-w-2xl">Soluciones para operar su carga en puerto y en tierra</h2>
      <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {servicios.map((s) => (
          <li class="bg-white rounded-lg p-6 shadow-sm border-t-4 border-teal">
            <h3 class="font-semibold text-lg">{s.titulo}</h3>
            <p class="mt-3 text-sm text-ink-soft leading-relaxed">{s.descripcion}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Clientes -->
  <section id="clientes" class="scroll-mt-20 py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <p class="font-display font-semibold text-teal uppercase tracking-widest text-sm">Clientes</p>
      <h2 class="mt-3 text-3xl md:text-4xl font-bold">Empresas que han confiado en Cargoban</h2>
      {clientes.length === 0 ? (
        <p class="mt-8 text-ink-soft">Listado de clientes pendiente de entrega por parte de Cargoban.</p>
      ) : (
        <ul class="mt-12 grid gap-8 grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 items-center">
          {clientes.map((c) => (
            <li class="flex items-center justify-center">
              {c.logo ? <img src={c.logo} alt={c.nombre} class="max-h-12 w-auto grayscale opacity-70" /> : <span class="font-semibold text-navy">{c.nombre}</span>}
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <!-- Contacto -->
  <section id="contacto" class="scroll-mt-20 bg-teal text-white py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="font-display font-semibold text-white/80 uppercase tracking-widest text-sm">Contacto</p>
        <h2 class="mt-3 text-white text-3xl md:text-4xl font-bold">Hablemos de su operación</h2>
        <p class="mt-6 text-white/90 leading-relaxed">
          Datos de contacto y formulario pendientes. Se incorporan en el siguiente bloque de trabajo.
        </p>
      </div>
      <ul class="grid gap-6 sm:grid-cols-2">
        {empresa.sedes.map((sede) => (
          <li class="rounded-lg bg-white/10 p-6">
            <h3 class="text-white font-semibold text-lg">{sede}</h3>
            <p class="mt-2 text-sm text-white/85">Dirección y teléfono por confirmar.</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
